rules_version = '2';

// Regras de segurança do Firestore do Synapse.
// Copie este conteúdo para o console do Firebase: Firestore Database → Regras → Publicar.
//
// Cada usuário só lê e escreve dentro de usuarios/{seu uid}/...
// Qualquer outro caminho (inclusive as antigas coleções globais) fica bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
